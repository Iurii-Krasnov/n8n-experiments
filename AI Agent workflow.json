    {
      "parameters": {
        "jsCode": "const weatherData = $input.all().map((item) => item.json);\nconst suggestions = weatherData.map((data) => {\n  let suggestion = \"\";\n  let has_alert = false;\n  if (data.main.temp < 10) {\n    suggestion += \"It is cold outside, wear a jacket. \";\n  } else if (data.main.temp > 25) {\n    suggestion += \"It is hot outside, wear light clothes. \";\n  } else {\n    suggestion += \"The temperature is moderate. \";\n  }\n  if (data.weather[0].main.toLowerCase().includes(\"rain\")) {\n    suggestion += \"Take an umbrella. \";\n    has_alert = true;\n  }\n  if (data.wind.speed > 10) {\n    suggestion += \"It is windy, wear a windbreaker. \";\n    has_alert = true;\n  }\n  return {\n    description: `Currently it is ${data.weather[0].description}.`,\n    temp: data.main.temp,\n    feels_like: data.main.feels_like,\n    wind: data.wind.speed,\n    suggestion: suggestion.trim(),\n    has_alert: has_alert\n  };\n});\nreturn suggestions;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
        64
      ],
      "id": "60241740-2b52-42e7-9586-1ad6c0132dda",
